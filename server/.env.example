NODE_ENV=development
PORT=4000

# Local development can use the embedded database when these are empty.
# Production requires PostgreSQL connection strings.
DATABASE_URL=
DIRECT_URL=

# Leave empty for locally generated development keys. Production must use
# unique random values of at least 32 characters for all three secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CSRF_SECRET=

FRONTEND_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Set only when frontend and API use subdomains of the same domain.
COOKIE_DOMAIN=

# Optional providers; add credentials only to the backend environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Realtime messaging (Pusher Channels)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
