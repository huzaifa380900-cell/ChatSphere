{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "nextjs"
    },
    "chatsphere-api": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/vercel-handler.ts",
      "buildCommand": "npm install --include=dev && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "chatsphere-api"
      }
    },
    {
      "source": "/auth/callback",
      "destination": {
        "service": "chatsphere-api"
      }
    },
    {
      "source": "/auth/callback/",
      "destination": {
        "service": "chatsphere-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
