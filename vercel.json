{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm run install:all",
  "buildCommand": "npm run build",
  "outputDirectory": "client/out",
  "cleanUrls": true,
  "functions": {
    "api/handler.ts": {
      "includeFiles": "server/dist/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__path=:path*"
    }
  ]
}
